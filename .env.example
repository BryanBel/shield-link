# Supabase — server-side only.
#
# These names carry no PUBLIC_ prefix on purpose: Astro exposes PUBLIC_* to client
# bundles, and the service role key bypasses row-level security, so leaking it hands out
# full read/write access to the database. Only src/utils/supabase.server.js reads them,
# and only /api/scan imports that.
#
# Both values: Supabase dashboard -> Project Settings -> API Keys. Take the *secret*
# key (sb_secret_...), not the publishable one — the publishable key is the public,
# browser-safe key and has no access to these tables at all.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# VirusTotal API v3 — free tier is enough. https://www.virustotal.com -> your profile -> API key
VIRUSTOTAL_API_KEY=tu-api-key-de-virustotal

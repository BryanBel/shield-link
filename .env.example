# PostgreSQL connection string. Any provider works — this project speaks plain SQL through
# Neon's serverless driver, not a vendor SDK.
#
# No PUBLIC_ prefix on purpose: Astro exposes PUBLIC_* to client bundles, and this string
# grants full access to the database. Only src/utils/db.server.js reads it, and only
# /api/scan and /api/health import that.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# VirusTotal API v3 — free tier is enough. virustotal.com -> your profile -> API key
VIRUSTOTAL_API_KEY=

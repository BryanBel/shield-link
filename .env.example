# PostgreSQL connection string for the application role (shieldlink_app — see schema.sql).
# Any provider works — this project speaks plain SQL through Neon's serverless driver, not a
# vendor SDK.
#
# No PUBLIC_ prefix on purpose: Astro exposes PUBLIC_* to client bundles. Only
# src/utils/db.server.js reads it, and only /api/scan and /api/health import that.
DATABASE_URL=postgresql://shieldlink_app:password@host/dbname?sslmode=require

# The owner's connection string. Local only — never set it on Vercel. It is used for one
# thing: applying schema.sql with `psql "$DATABASE_URL_ADMIN" -f schema.sql`.
DATABASE_URL_ADMIN=postgresql://owner:password@host/dbname?sslmode=require

# VirusTotal API v3 — free tier is enough. virustotal.com -> your profile -> API key
VIRUSTOTAL_API_KEY=

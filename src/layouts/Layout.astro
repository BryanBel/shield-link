---
import { ESTILO_INICIAL } from '../styles/estilos/registro.js';

// Order matters: the contract's defaults, then every style (any .css dropped into
// src/styles/estilos/ is picked up here, no import to add), then the components.
import '../styles/estilos/_contrato.css';
import.meta.glob(['../styles/estilos/*.css', '!../styles/estilos/_contrato.css'], { eager: true });
import '../styles/base.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-estilo={ESTILO_INICIAL} data-modo="oscuro">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Shield Link - Detector de Phishing" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<!--
			Applies the saved style and mode before the first paint, so the page never flashes
			the default look. Kept tiny, inline and static on purpose: astro.config.mjs hashes
			this exact text into the Content-Security-Policy, and utils/temas.js validates the
			style against the registry once the page loads.
		-->
		<script is:inline>(function () {
	var raiz = document.documentElement, estilo = null, modo = null;
	try { estilo = localStorage.getItem('shieldlink:estilo'); modo = localStorage.getItem('shieldlink:modo'); } catch (e) {}
	if (estilo && /^[a-z0-9-]+$/.test(estilo)) raiz.dataset.estilo = estilo;
	raiz.dataset.modo = modo === 'claro' || modo === 'oscuro' ? modo : (matchMedia('(prefers-color-scheme: light)').matches ? 'claro' : 'oscuro');
})();</script>
	</head>
	<body>
		<slot />
	</body>
</html>

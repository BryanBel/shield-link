---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shield Link - Análisis de Seguridad">
    <main>
        <h1>🛡️ Shield Link</h1>
        <p>Análisis instantáneo de enlaces sospechosos</p>
        
        <div id="inputContainer" class="scanner-card">
            <input type="text" id="linkInput" placeholder="https://ejemplo-sospechoso.com" />
            <button id="scanBtn">Analizar Ahora</button>
        </div>

        <div id="result" class="hidden"></div>
    </main>
</Layout>

<script>
    import { analizarSeguridad } from '../utils/scanner.js';

    const btn = document.getElementById('scanBtn');
    const input = document.getElementById('linkInput') as HTMLInputElement;
    const resultDiv = document.getElementById('result');
    const inputContainer = document.getElementById('inputContainer');

    btn?.addEventListener('click', async () => {
        const url = input.value.trim();
        if (!url || !resultDiv || !inputContainer) return;

        // Estado de carga
        inputContainer.classList.add('hidden');
        resultDiv.className = "info";
        resultDiv.innerHTML = `
            <div class="loader"></div>
            <p>Consultando base de datos global y motores de seguridad...</p>
        `;
        resultDiv.classList.remove('hidden');

        const res = await analizarSeguridad(url);

        // --- LÓGICA DE MOSTRADO SEGÚN EL TIPO DE RESULTADO ---
        if (res.error) {
            // Caso 1: Error de formato (Naranja/Aviso)
            resultDiv.className = "warning";
            resultDiv.innerHTML = `
                <div class="verdict-content">
                    <span class="icon">ℹ️</span>
                    <h2>Formato Incorrecto</h2>
                    <p>${res.motivo}</p>
                    <button id="resetBtn" class="secondary-btn">Corregir enlace</button>
                </div>
            `;
        } else {
            // Caso 2: Veredicto de seguridad (Verde o Rojo)
            resultDiv.className = res.seguro ? 'safe' : 'danger';
            resultDiv.innerHTML = `
                <div class="verdict-content">
                    <span class="icon">${res.seguro ? '✅' : '❌'}</span>
                    <h2>${res.seguro ? 'Enlace Seguro' : 'Enlace Peligroso'}</h2>
                    <p>${res.motivo}</p>
                    <button id="resetBtn" class="secondary-btn">Escanear otro enlace</button>
                </div>
            `;
        }

        // Configurar botón de retorno
        document.getElementById('resetBtn')?.addEventListener('click', () => {
            resultDiv.classList.add('hidden');
            inputContainer.classList.remove('hidden');
            
            // Si fue error de formato, mantenemos el texto para que el usuario solo lo corrija
            if (!res.error) {
                input.value = "";
            }
            input.focus();
        });
    });
</script>

<style>
    .hidden { display: none; }
    
    .verdict-content { padding: 1rem; }
    .icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
    
    .info { color: #3b82f6; padding: 2rem; }
    
    /* Estilo para Errores de Formato (Naranja) */
    .warning {
        border: 2px solid #f39c12;
        background: rgba(243, 156, 18, 0.1);
        padding: 2rem;
        border-radius: 12px;
        color: #f39c12;
    }

    .safe { 
        border: 2px solid #2ecc71; 
        background: rgba(46, 204, 113, 0.1); 
        padding: 2rem; 
        border-radius: 12px; 
    }
    
    .danger { 
        border: 2px solid #ff4d4d; 
        background: rgba(255, 77, 77, 0.1); 
        padding: 2rem; 
        border-radius: 12px; 
    }

    .secondary-btn {
        margin-top: 1.5rem;
        background: #334155;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        width: auto;
        padding: 10px 20px;
        border-radius: 6px;
    }

    .loader {
        border: 4px solid #334155;
        border-top: 4px solid #3b82f6;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>
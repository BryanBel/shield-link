---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shield Link - Análisis de Seguridad">
    <main>
        <h1><span class="logo" aria-hidden="true">🛡️</span> <span class="marca">Shield Link</span></h1>
        <p class="lema">Análisis instantáneo de enlaces sospechosos</p>

        <div id="inputContainer" class="scanner-card">
            <input type="text" id="linkInput" placeholder="ejemplo-sospechoso.com o https://…" aria-label="Enlace a analizar" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="url" />
            <button id="scanBtn" type="button">Analizar Ahora</button>
        </div>

        <div id="result" class="hidden" tabindex="-1" aria-live="polite"></div>
    </main>

    <!--
        En pantallas anchas flota: temas.js lo posiciona y lo cambia de lugar tras cada estilo.
        En el teléfono se queda quieto, centrado bajo la tarjeta, con la pista debajo.
        Tras el easter egg, la barra de estilos ocupa su lugar.
    -->
    <button id="btnDado" class="dado" type="button" aria-label="Cambiar a un diseño al azar" title="Diseño al azar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="8" cy="8" r="1.2" fill="currentColor"></circle><circle cx="16" cy="8" r="1.2" fill="currentColor"></circle>
            <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
            <circle cx="8" cy="16" r="1.2" fill="currentColor"></circle><circle cx="16" cy="16" r="1.2" fill="currentColor"></circle>
        </svg>
    </button>

    <small class="pista" aria-hidden="true"></small>
</Layout>

<script>
    import { analizarSeguridad } from '../utils/scanner.js';
    import { normalizarEntrada } from '../utils/normalizarEntrada.js';
    import { renderAviso, renderInforme } from '../utils/renderInforme.js';
    import { iniciarTemas } from '../utils/temas.js';

    iniciarTemas();

    const main = document.querySelector('main') as HTMLElement;
    const btn = document.getElementById('scanBtn');
    const input = document.getElementById('linkInput') as HTMLInputElement;
    const resultDiv = document.getElementById('result') as HTMLElement;
    const inputContainer = document.getElementById('inputContainer') as HTMLElement;

    function cargando() {
        const loader = document.createElement('div');
        loader.className = 'loader';
        const texto = document.createElement('p');
        texto.className = 'cargando-texto';
        texto.textContent = 'Investigando el enlace: reputación, dominio, certificado y destino…';
        return [loader, texto];
    }

    async function escanear() {
        const url = input.value.trim();
        if (!url) return;

        // Closes the phone keyboard, which would otherwise leave the page scrolled halfway.
        input.blur();
        inputContainer.classList.add('hidden');
        resultDiv.replaceChildren(...cargando());
        resultDiv.classList.remove('hidden');

        const res = await analizarSeguridad(url);

        // El botón de abrir usa el enlace tal como se escribió (con su query), no la versión
        // recortada del informe. Los datos del informe se insertan como texto, nunca como HTML.
        const urlAbrir = normalizarEntrada(url).url?.href ?? null;
        resultDiv.replaceChildren(res.error ? renderAviso(res) : renderInforme(res, { urlAbrir }));
        main.classList.toggle('con-resultado', !res.error);
        // The whole card from its top, verdict included, instead of wherever focus lands.
        resultDiv.focus({ preventScroll: true });
        scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });

        document.getElementById('resetBtn')?.addEventListener('click', () => {
            main.classList.remove('con-resultado');
            resultDiv.classList.add('hidden');
            resultDiv.replaceChildren();
            inputContainer.classList.remove('hidden');

            // Si fue un error de formato, mantenemos el texto para que solo lo corrija.
            if (!res.error) input.value = '';
            input.focus();
        });
    }

    btn?.addEventListener('click', escanear);
    input.addEventListener('keydown', (evento) => {
        if (evento.key === 'Enter') escanear();
    });
</script>

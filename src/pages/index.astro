---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shield Link - Análisis de Seguridad">
    <main>
        <h1>🛡️ Shield Link</h1>
        <p>Análisis instantáneo de enlaces sospechosos</p>

        <div id="inputContainer" class="scanner-card">
            <input type="text" id="linkInput" placeholder="ejemplo-sospechoso.com o https://…" aria-label="Enlace a analizar" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="url" />
            <button id="scanBtn" type="button">Analizar Ahora</button>
        </div>

        <div id="result" class="hidden" tabindex="-1" aria-live="polite"></div>
    </main>
</Layout>

<script>
    import { analizarSeguridad } from '../utils/scanner.js';
    import { renderAviso, renderInforme } from '../utils/renderInforme.js';

    const main = document.querySelector('main') as HTMLElement;
    const btn = document.getElementById('scanBtn');
    const input = document.getElementById('linkInput') as HTMLInputElement;
    const resultDiv = document.getElementById('result') as HTMLElement;
    const inputContainer = document.getElementById('inputContainer') as HTMLElement;

    function cargando() {
        const loader = document.createElement('div');
        loader.className = 'loader';
        const texto = document.createElement('p');
        texto.className = 'cargando-texto';
        texto.textContent = 'Investigando el enlace: reputación, dominio, certificado y destino…';
        return [loader, texto];
    }

    async function escanear() {
        const url = input.value.trim();
        if (!url) return;

        inputContainer.classList.add('hidden');
        resultDiv.replaceChildren(...cargando());
        resultDiv.classList.remove('hidden');

        const res = await analizarSeguridad(url);

        // Los datos del informe se insertan como texto, nunca como HTML.
        resultDiv.replaceChildren(res.error ? renderAviso(res) : renderInforme(res));
        main.classList.toggle('con-resultado', !res.error);
        resultDiv.focus();

        document.getElementById('resetBtn')?.addEventListener('click', () => {
            main.classList.remove('con-resultado');
            resultDiv.classList.add('hidden');
            resultDiv.replaceChildren();
            inputContainer.classList.remove('hidden');

            // Si fue un error de formato, mantenemos el texto para que solo lo corrija.
            if (!res.error) input.value = '';
            input.focus();
        });
    }

    btn?.addEventListener('click', escanear);
    input.addEventListener('keydown', (evento) => {
        if (evento.key === 'Enter') escanear();
    });
</script>

<style is:global>
    .hidden { display: none; }
    #result:focus { outline: none; }

    .loader {
        border: 4px solid #334155;
        border-top: 4px solid #3b82f6;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
        margin: 1rem auto;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .cargando-texto { color: #93c5fd; }

    .informe {
        text-align: left;
        border: 2px solid var(--borde-nivel, #334155);
        background: var(--fondo-nivel, transparent);
        border-radius: 12px;
        padding: 1.25rem;
    }
    .informe-seguro { --borde-nivel: #2ecc71; --fondo-nivel: rgba(46, 204, 113, 0.08); }
    .informe-precaucion { --borde-nivel: #f39c12; --fondo-nivel: rgba(243, 156, 18, 0.08); }
    .informe-peligroso { --borde-nivel: #ff4d4d; --fondo-nivel: rgba(255, 77, 77, 0.08); }
    .informe-aviso { --borde-nivel: #f39c12; --fondo-nivel: rgba(243, 156, 18, 0.08); text-align: center; }

    .informe-cabecera { display: flex; align-items: center; gap: 0.75rem; }
    .informe-aviso .informe-cabecera { justify-content: center; }
    .informe-icono { font-size: 2.25rem; line-height: 1; }
    .informe-cabecera h2 { margin: 0; font-size: 1.35rem; }
    .certeza {
        display: inline-block;
        margin-top: 0.25rem;
        padding: 0.1rem 0.55rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid currentColor;
    }
    .certeza-alta { color: #2ecc71; }
    .certeza-media { color: #f39c12; }
    .certeza-baja { color: #94a3b8; }
    .informe-enlace {
        margin: 0.9rem 0 0;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.6);
        display: grid;
        gap: 0.1rem;
        overflow-wrap: anywhere;
    }
    .informe-enlace strong { font-size: 1.05rem; }
    .informe-enlace span { font-size: 0.8rem; color: #94a3b8; }
    .informe-motivo { margin: 1rem 0; line-height: 1.5; }

    .ficha {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0 0 1.25rem;
    }
    @media (min-width: 480px) {
        .ficha { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .ficha-dato {
        margin: 0;
        padding: 0.55rem 0.7rem;
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.6);
        border-left: 3px solid var(--color-dato, #475569);
    }
    .ficha-dato dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; }
    .ficha-dato dd { margin: 0.15rem 0 0; font-weight: 600; font-size: 0.95rem; overflow-wrap: anywhere; }
    .ficha-bien { --color-dato: #2ecc71; }
    .ficha-alerta { --color-dato: #f39c12; }
    .ficha-peligro { --color-dato: #ff4d4d; }

    .informe-porque h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; margin: 0 0 0.5rem; }
    .informe-porque > .senales { margin-bottom: 0.5rem; }
    .senales-plegadas { margin-top: 0.4rem; }
    .senales-plegadas > summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .senales-plegadas > summary::-webkit-details-marker { display: none; }
    .senales-plegadas > summary::after { content: '▸'; color: #94a3b8; }
    .senales-plegadas[open] > summary::after { content: '▾'; }
    .senales-plegadas > .senales { margin: 0.5rem 0 0 0.25rem; }
    .senales-plegadas.senal-bien > summary .senal-icono { background: #2ecc71; }
    .senales-plegadas.senal-info > summary .senal-icono { background: #94a3b8; }
    .senales { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
    .senal { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.6rem; align-items: start; }
    .senal strong { display: block; font-size: 0.95rem; }
    .senal p { margin: 0.15rem 0 0; font-size: 0.85rem; color: #cbd5e1; line-height: 1.45; }
    .senal-icono {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 0.8rem;
        font-weight: 700;
        color: #0f172a;
    }
    .senal-peligro .senal-icono { background: #ff4d4d; }
    .senal-alerta .senal-icono { background: #f39c12; }
    .senal-bien .senal-icono { background: #2ecc71; }
    .senal-info .senal-icono { background: #94a3b8; }

    .informe-tecnico { margin-top: 1.25rem; border: 1px solid #334155; border-radius: 8px; }
    .informe-tecnico > summary { cursor: pointer; font-weight: 600; padding: 0.6rem 0.8rem; }
    .tecnico-cuerpo { padding: 0 0.8rem 0.8rem; display: grid; gap: 1rem; }
    .tecnico-bloque h4 { margin: 0 0 0.4rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #93c5fd; }
    .tecnico-bloque dl {
        margin: 0;
        display: grid;
        grid-template-columns: minmax(7rem, 35%) 1fr;
        gap: 0.3rem 0.75rem;
    }
    .tecnico-bloque dt { font-size: 0.8rem; color: #94a3b8; }
    .tecnico-bloque dd { margin: 0; font-size: 0.85rem; overflow-wrap: anywhere; }
    .tecnico-bloque ul { margin: 0; padding-left: 1.1rem; }

    .informe-nota { font-size: 0.8rem; color: #94a3b8; margin: 1rem 0 0; }

    .secondary-btn {
        margin-top: 1.25rem;
        background: #334155;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        width: auto;
        padding: 10px 20px;
        border-radius: 6px;
    }
    .informe:not(.informe-aviso) .secondary-btn { display: block; margin-left: auto; margin-right: auto; }
    .informe-extra { margin-top: 1.25rem; }

    /*
     * Wide screens: the whole report fits the window. The header shrinks to one line, the
     * card splits into two columns, and anything that grows — the folded signals, the
     * technical detail — scrolls inside its own column instead of pushing the page down.
     * Phones keep the single column; there is no height to fit it into.
     */
    @media (min-width: 960px) and (min-height: 560px) {
        main.con-resultado {
            max-width: 1120px;
            height: calc(100dvh - 3rem);
            margin: 1.5rem 0;
            padding: 1.25rem 1.5rem;
            display: flex;
            flex-direction: column;
        }
        main.con-resultado > h1 { font-size: 1.5rem; margin: 0; }
        main.con-resultado > p { margin: 0.25rem 0 1rem; font-size: 0.85rem; color: #94a3b8; }
        main.con-resultado #result:not(.hidden) { flex: 1; min-height: 0; display: flex; }

        .con-resultado .informe {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
            gap: 1.5rem;
        }
        .con-resultado .informe-principal,
        .con-resultado .informe-extra {
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
        .con-resultado .informe-extra {
            margin-top: 0;
            padding-left: 1.5rem;
            border-left: 1px solid #334155;
        }
        .con-resultado .informe-motivo { margin: 0.75rem 0; }
        .con-resultado .ficha { margin-bottom: 0.75rem; }
    }
</style>
